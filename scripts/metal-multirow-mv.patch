+const struct ggml_metal_mv_mr_cfg * ggml_metal_mv_mr_get_cfg(void) {
+    static const ggml_metal_mv_mr_cfg cfg = [] {
+        auto env_int = [](const char * name, int def) {
+            const char * e = getenv(name);
+            return e ? atoi(e) : def;
+        };
+
+        ggml_metal_mv_mr_cfg c;
+        c.enabled  = env_int("GGML_METAL_MV_MULTIROW",      0) != 0;
+        c.max_ne11 = env_int("GGML_METAL_MV_MULTIROW_MAX", 16);
+        c.max_r    = env_int("GGML_METAL_MV_MULTIROW_R",   16);
+        c.nr0      = env_int("GGML_METAL_MV_MULTIROW_NR0",  0);
+        c.nsg      = env_int("GGML_METAL_MV_MULTIROW_NSG",  2);
+        c.mma_min  = env_int("GGML_METAL_MV_MULTIROW_MMA",  5);
+
+        c.max_r = c.max_r < 2 ? 2 : (c.max_r > 16 ? 16 : c.max_r);
+        if (c.nr0 != 0 && c.nr0 != 1 && c.nr0 != 2 && c.nr0 != 4) {
+            c.nr0 = 0;
+        }
+        c.nsg = c.nsg < 1 ? 1 : (c.nsg > 8 ? 8 : c.nsg);
+        return c;
+    }();
+
+    return &cfg;
+}
+
+bool ggml_metal_op_mul_mat_use_mv_mr(const struct ggml_tensor * op) {
+    const ggml_metal_mv_mr_cfg * cfg = ggml_metal_mv_mr_get_cfg();
+    if (!cfg->enabled) {
+        return false;
+    }
+
+    const ggml_tensor * src0 = op->src[0];
+    const ggml_tensor * src1 = op->src[1];
+
+    switch (src0->type) {
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_Q8_0:
+            break;
+        default:
+            return false;
+    }
+
+    const int64_t ne11 = src1->ne[1];
+
+    // the kernels load src1 as float4 along rows: rows must be contiguous and 16-byte aligned
+    return src1->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32 &&
+           !ggml_is_transposed(src0) && !ggml_is_transposed(src1) &&
+           src0->nb[0] == ggml_type_size(src0->type) &&
+           src1->nb[0] == sizeof(float) &&
+           src1->nb[1] % 16 == 0 && src1->nb[2] % 16 == 0 && src1->nb[3] % 16 == 0 &&
+           ((uintptr_t) src1->data) % 16 == 0 &&
+           src0->ne[0] % ggml_blck_size(src0->type) == 0 &&
+           ne11 >= 2 && ne11 <= cfg->max_ne11;
+}
