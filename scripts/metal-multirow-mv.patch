+template<short R, short NR0>
+kernel void kernel_mul_mv_mr_q4_K_f32(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr uint16_t kmask1 = 0x3f3f;
+    constexpr uint16_t kmask2 = 0x0f0f;
+    constexpr uint16_t kmask3 = 0xc0c0;
+
+    const short ix = tiisg/8;  // 0...3: block within a group of 4 consecutive blocks
+    const short it = tiisg%8;
+    const short iq = it/4;     // 0 or 1: which 64-element half of each 128-element half-block
+    const short ir = it%4;     // 0...3: 8-element slice
+
+    const int nb = args.ne00/QK_K;
+
+    const int first_row = (tgpig.x*NSG + sgitg)*NR0;
+    const int r1 = tgpig.y*R;
+    const int im = tgpig.z;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+
+    device const block_q4_K * x[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int i01 = min(first_row + row, args.ne01 - 1);
+        x[row] = (device const block_q4_K *) (src0 + offset0 + (uint64_t)i01*args.nb01);
+    }
+
+    const int nr1 = min((int) R, args.ne11 - r1); // valid src1 rows in this tile
+
+    device const float * y = (device const float *) (src1 + (uint64_t)r1*args.nb11 + (uint64_t)i12*args.nb12 + (uint64_t)i13*args.nb13)
+        + ix*QK_K + 64*iq + 8*ir;
+    const uint64_t ys = args.nb11/sizeof(float);
+
+    float sumf[R][NR0];
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[r][row] = 0.f;
+        }
+    }
+
+    for (int ib = ix; ib < nb; ib += 4) {
+        // the 32 weights of this lane, 4 groups of 8: y offsets 0, 32, 128, 160
+        float4 w[NR0][4][2];
+
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            device const block_q4_K * xb = x[row] + ib;
+
+            device const uint16_t * sc = (device const uint16_t *) xb->scales + iq;
+
+            uint16_t sc16[4];
+            thread const uint8_t * sc8 = (thread const uint8_t *) sc16;
+
+            sc16[0] = sc[0] & kmask1;
+            sc16[1] = sc[2] & kmask1;
+            sc16[2] = ((sc[4] >> 0) & kmask2) | ((sc[0] & kmask3) >> 2);
+            sc16[3] = ((sc[4] >> 4) & kmask2) | ((sc[2] & kmask3) >> 2);
+
+            const float d    = xb->d;
+            const float dmin = xb->dmin;
+
+            device const uchar4 * q = (device const uchar4 *) (xb->qs + 32*iq + 8*ir);
+
+            const uchar4 q1a = q[0];
+            const uchar4 q1b = q[1];
+            const uchar4 q2a = q[16];
+            const uchar4 q2b = q[17];
+
+            const float dl0 = d*sc8[0], ml0 = dmin*sc8[2];
+            const float dl1 = d*sc8[1], ml1 = dmin*sc8[3];
+            const float dl2 = d*sc8[4], ml2 = dmin*sc8[6];
+            const float dl3 = d*sc8[5], ml3 = dmin*sc8[7];
+
+            w[row][0][0] = float4(q1a & 0xF)*dl0 - ml0;
+            w[row][0][1] = float4(q1b & 0xF)*dl0 - ml0;
+            w[row][1][0] = float4(q1a >>  4)*dl1 - ml1;
+            w[row][1][1] = float4(q1b >>  4)*dl1 - ml1;
+            w[row][2][0] = float4(q2a & 0xF)*dl2 - ml2;
+            w[row][2][1] = float4(q2b & 0xF)*dl2 - ml2;
+            w[row][3][0] = float4(q2a >>  4)*dl3 - ml3;
+            w[row][3][1] = float4(q2b >>  4)*dl3 - ml3;
+        }
+
+        device const float * yb = y + (uint64_t)ib*QK_K - (uint64_t)ix*QK_K;
+
+        FOR_UNROLL (short r = 0; r < R; ++r) {
+            device const float4 * y4 = (device const float4 *) (yb + (uint64_t)min((int) r, nr1 - 1)*ys);
+
+            const float4 ya = y4[ 0], yb4 = y4[ 1];
+            const float4 yc = y4[ 8], yd  = y4[ 9];
+            const float4 ye = y4[32], yf  = y4[33];
+            const float4 yg = y4[40], yh  = y4[41];
+
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                sumf[r][row] += dot(w[row][0][0], ya) + dot(w[row][0][1], yb4)
+                              + dot(w[row][1][0], yc) + dot(w[row][1][1], yd)
+                              + dot(w[row][2][0], ye) + dot(w[row][2][1], yf)
+                              + dot(w[row][3][0], yg) + dot(w[row][3][1], yh);
+            }
+        }
+    }
+
+    helper_mv_mr_write<R, NR0>(args, dst, sumf, first_row, r1, im, tiisg);
+}
+
+template<short R, short NR0>
+kernel void kernel_mul_mv_mr_q6_K_f32(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+
+    const int nb = args.ne00/QK_K;
+
+    const int first_row = (tgpig.x*NSG + sgitg)*NR0;
+    const int r1 = tgpig.y*R;
+    const int im = tgpig.z;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+
+    device const block_q6_K * x[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int i01 = min(first_row + row, args.ne01 - 1);
+        x[row] = (device const block_q6_K *) (src0 + offset0 + (uint64_t)i01*args.nb01);
+    }
+
+    const int nr1 = min((int) R, args.ne11 - r1);
+
+    // same lane layout as kernel_mul_mv_q6_K_f32: 2 blocks per step, 16 weights per lane per block
+    const short tid = tiisg/2;
+    const short ix  = tiisg%2;
+    const short ip  = tid/8;         // 0 or 1
+    const short il  = tid%8;
+    const short l0  = 4*il;
+    const short is  = 8*ip + l0/16;
+
+    const short y_offset   = 128*ip + l0;
+    const short q_offset_l =  64*ip + l0;
+    const short q_offset_h =  32*ip + l0;
+
+    device const float * y = (device const float *) (src1 + (uint64_t)r1*args.nb11 + (uint64_t)i12*args.nb12 + (uint64_t)i13*args.nb13) + y_offset;
+    const uint64_t ys = args.nb11/sizeof(float);
+
+    float sumf[R][NR0];
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[r][row] = 0.f;
+        }
+    }
+
+    for (int i = ix; i < nb; i += 2) {
+        // 4 groups of 4 weights: y offsets 0, 32, 64, 96
+        float4 w[NR0][4];
+
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            device const block_q6_K * xb = x[row] + i;
+
+            // block_q6_K is 210 bytes: only 2-byte alignment is guaranteed
+            device const packed_uchar4 * q1p = (device const packed_uchar4 *) (xb->ql + q_offset_l);
+            device const packed_uchar4 * q2p = (device const packed_uchar4 *) (xb->ql + q_offset_l + 32);
+            device const packed_uchar4 * qhp = (device const packed_uchar4 *) (xb->qh + q_offset_h);
+
+            const uchar4 q1 = uchar4(*q1p);
+            const uchar4 q2 = uchar4(*q2p);
+            const uchar4 qh = uchar4(*qhp);
+
+            device const int8_t * sc = xb->scales + is;
+            const float d = xb->d;
+
+            w[row][0] = (float4(char4((q1 & 0xF) | ((qh & 0x03) << 4))) - 32.f) * (d*sc[0]);
+            w[row][1] = (float4(char4((q2 & 0xF) | ((qh & 0x0C) << 2))) - 32.f) * (d*sc[2]);
+            w[row][2] = (float4(char4((q1 >>  4) | ((qh & 0x30) << 0))) - 32.f) * (d*sc[4]);
+            w[row][3] = (float4(char4((q2 >>  4) | ((qh & 0xC0) >> 2))) - 32.f) * (d*sc[6]);
+        }
+
+        device const float * yb = y + (uint64_t)i*QK_K;
+
+        FOR_UNROLL (short r = 0; r < R; ++r) {
+            device const float * yr = yb + (uint64_t)min((int) r, nr1 - 1)*ys;
+
+            // y_offset is a multiple of 4 floats, so these are 16-byte aligned loads
+            const float4 y0 = *((device const float4 *) (yr +  0));
+            const float4 y1 = *((device const float4 *) (yr + 32));
+            const float4 y2 = *((device const float4 *) (yr + 64));
+            const float4 y3 = *((device const float4 *) (yr + 96));
+
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                sumf[r][row] += dot(w[row][0], y0) + dot(w[row][1], y1) + dot(w[row][2], y2) + dot(w[row][3], y3);
+            }
+        }
+    }
+
+    helper_mv_mr_write<R, NR0>(args, dst, sumf, first_row, r1, im, tiisg);
+}
+
+template<short R, short NR0>
+kernel void kernel_mul_mv_mr_q8_0_f32(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr short NQ = 8;
+
+    const int nb = args.ne00/QK8_0;
+
+    const int first_row = (tgpig.x*NSG + sgitg)*NR0;
+    const int r1 = tgpig.y*R;
+    const int im = tgpig.z;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+
+    device const block_q8_0 * x[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int i01 = min(first_row + row, args.ne01 - 1);
+        x[row] = (device const block_q8_0 *) (src0 + offset0 + (uint64_t)i01*args.nb01);
+    }
+
+    const int nr1 = min((int) R, args.ne11 - r1);
+
+    // lane layout of kernel_mul_mv_q8_0_f32: 8 blocks per step, 8 weights per lane per block
+    const short ix = tiisg/(N_SIMDWIDTH/NQ); // 0...7
+    const short il = tiisg%(N_SIMDWIDTH/NQ); // 0...3
+
+    device const float * y = (device const float *) (src1 + (uint64_t)r1*args.nb11 + (uint64_t)i12*args.nb12 + (uint64_t)i13*args.nb13) + il*NQ;
+    const uint64_t ys = args.nb11/sizeof(float);
+
+    float sumf[R][NR0];
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[r][row] = 0.f;
+        }
+    }
+
+    for (int ib = ix; ib < nb; ib += NQ) {
+        float4 w[NR0][2];
+
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            device const block_q8_0 * xb = x[row] + ib;
+
+            // block_q8_0 is 34 bytes: only 2-byte alignment is guaranteed
+            device const packed_char4 * qs = (device const packed_char4 *) (xb->qs + il*NQ);
+
+            const float d = xb->d;
+
+            w[row][0] = float4(char4(qs[0]))*d;
+            w[row][1] = float4(char4(qs[1]))*d;
+        }
+
+        device const float * yb = y + (uint64_t)ib*QK8_0;
+
+        FOR_UNROLL (short r = 0; r < R; ++r) {
+            device const float4 * y4 = (device const float4 *) (yb + (uint64_t)min((int) r, nr1 - 1)*ys);
+
+            const float4 y0 = y4[0];
+            const float4 y1 = y4[1];
+
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                sumf[r][row] += dot(w[row][0], y0) + dot(w[row][1], y1);
+            }
+        }
+    }
+
+    helper_mv_mr_write<R, NR0>(args, dst, sumf, first_row, r1, im, tiisg);
+}
+
+typedef decltype(kernel_mul_mv_mr_q4_K_f32<2, 2>) mul_mv_mr_t;
+
+#define MV_MR_INST(T, R, NR0) \
+template [[host_name("kernel_mul_mv_mr_" #T "_f32_r" #R "_nr0_" #NR0)]] kernel mul_mv_mr_t kernel_mul_mv_mr_##T##_f32<R, NR0>;
+
+#define MV_MR_INST_ALL_R(T, NR0) \
+    MV_MR_INST(T,  2, NR0) MV_MR_INST(T,  3, NR0) MV_MR_INST(T,  4, NR0) MV_MR_INST(T,  5, NR0) \
+    MV_MR_INST(T,  6, NR0) MV_MR_INST(T,  7, NR0) MV_MR_INST(T,  8, NR0) MV_MR_INST(T,  9, NR0) \
+    MV_MR_INST(T, 10, NR0) MV_MR_INST(T, 11, NR0) MV_MR_INST(T, 12, NR0) MV_MR_INST(T, 13, NR0) \
+    MV_MR_INST(T, 14, NR0) MV_MR_INST(T, 15, NR0) MV_MR_INST(T, 16, NR0)
+
+MV_MR_INST_ALL_R(q4_K, 1)
+MV_MR_INST_ALL_R(q4_K, 2)
+MV_MR_INST_ALL_R(q4_K, 4)
+MV_MR_INST_ALL_R(q6_K, 1)
+MV_MR_INST_ALL_R(q6_K, 2)
+MV_MR_INST_ALL_R(q6_K, 4)
+MV_MR_INST_ALL_R(q8_0, 1)
+MV_MR_INST_ALL_R(q8_0, 2)
+MV_MR_INST_ALL_R(q8_0, 4)
+
+// ======================= small-batch simdgroup-MMA mat-vec ("mv_mma"), 2..16 src1 rows
+//
+// Why not the scalar multi-row kernel above for B > 4: every src1 value it loads feeds only NR0 FMAs, so at
+// B = 8..16 it is bound by src1 loads from L1 (~0.5-0.7 TB/s), not by the weight stream. Here the reuse is done
+// by 8x8 simdgroup matrices instead: per K step of 128 the threadgroup stages the src1 tile (8*NC rows x 128,
+// half) once, each simdgroup dequantizes its 16 src0 rows x 128 into its own threadgroup slice (half), and
+// multiplies 16 x 128 by 128 x 8*NC with simdgroup_multiply_accumulate (f32 accumulators). Unlike kernel_mul_mm
+// the src1 tile is 8 or 16 rows, not 32, and the weights are dequantized with wide loads, 64 weights per lane.
+//
+// threadgroup: 4 simdgroups (128 threads), 64 src0 rows; grid: (ceil(ne01/64), ceil(ne11/(8*NC)), ne12*ne13)
+// requires ne00 % 128 == 0
+
+#define MV_MMA_NSG 4
+#define MV_MMA_RS  16   // src0 rows per simdgroup
+#define MV_MMA_KS  128  // K step
+
+// dequantize 64 weights of one src0 row into dst (threadgroup, half): part p (0/1) of the 128-wide K step at k0
+static inline void mv_mma_deq(device const block_q4_K * x, int k0, short p, threadgroup half * dst) {
+    device const block_q4_K * xb = x + k0/QK_K;
+    const short h = (k0 % QK_K)/MV_MMA_KS;            // which half of the super-block
+    const short j = 4*h + 2*p;                        // first of the two 32-element sub-blocks (low nibbles)
+
+    device const uchar * s = xb->scales;
+    uchar sc0, m0, sc1, m1;
+    if (j < 4) {
+        sc0 = s[j] & 63; m0 = s[j + 4] & 63;
+        sc1 = s[j + 1] & 63; m1 = s[j + 5] & 63;
+    } else {
+        sc0 = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4); m0 = (s[j + 4] >> 4) | ((s[j    ] >> 6) << 4);
+        sc1 = (s[j + 5] & 0xF) | ((s[j - 3] >> 6) << 4); m1 = (s[j + 5] >> 4) | ((s[j + 1] >> 6) << 4);
+    }
+    const float d = xb->d, dmin = xb->dmin;
+    const float dl0 = d*sc0, ml0 = dmin*m0;
+    const float dl1 = d*sc1, ml1 = dmin*m1;
+
+    device const uchar4 * q = (device const uchar4 *) (xb->qs + 32*j/2);
+    threadgroup half4 * d4 = (threadgroup half4 *) dst;
+    FOR_UNROLL (short i = 0; i < 8; ++i) {
+        const uchar4 v = q[i];
+        d4[i    ] = half4(float4(v & 0xF)*dl0 - ml0);
+        d4[i + 8] = half4(float4(v >>  4)*dl1 - ml1);
+    }
+}
+
+static inline void mv_mma_deq(device const block_q8_0 * x, int k0, short p, threadgroup half * dst) {
+    threadgroup half4 * d4 = (threadgroup half4 *) dst;
+    FOR_UNROLL (short b = 0; b < 2; ++b) {
+        device const block_q8_0 * xb = x + k0/QK8_0 + 2*p + b;
+        const float d = xb->d;
+        device const packed_char4 * qs = (device const packed_char4 *) xb->qs;
+        FOR_UNROLL (short i = 0; i < 8; ++i) {
+            d4[8*b + i] = half4(float4(char4(qs[i]))*d);
+        }
+    }
+}
+
+static inline void mv_mma_deq(device const block_q6_K * x, int k0, short p, threadgroup half * dst) {
+    device const block_q6_K * xb = x + k0/QK_K;
+    const short h = (k0 % QK_K)/MV_MMA_KS;
+
+    // block_q6_K is 210 bytes: only 2-byte alignment
+    device const packed_uchar4 * ql0 = (device const packed_uchar4 *) (xb->ql + 64*h + 16*p);
+    device const packed_uchar4 * ql1 = (device const packed_uchar4 *) (xb->ql + 64*h + 16*p + 32);
+    device const packed_uchar4 * qh  = (device const packed_uchar4 *) (xb->qh + 32*h + 16*p);
+    device const int8_t * sc = xb->scales + 8*h + p;
+    const float d = xb->d;
+    const float s0 = d*sc[0], s1 = d*sc[2], s2 = d*sc[4], s3 = d*sc[6];
+
+    // element l = 16p + i (i < 16) of each 32-wide group g lands at g*32 + 16p + i
+    threadgroup half4 * d4 = (threadgroup half4 *) (dst - 64*p); // dst points at 64*p within the row
+    FOR_UNROLL (short i = 0; i < 4; ++i) {
+        const uchar4 a = uchar4(ql0[i]);
+        const uchar4 b = uchar4(ql1[i]);
+        const uchar4 c = uchar4(qh[i]);
+        d4[ 0 + 4*p + i] = half4((float4(char4((a & 0xF) | ((c & 0x03) << 4))) - 32.f)*s0);
+        d4[ 8 + 4*p + i] = half4((float4(char4((b & 0xF) | ((c & 0x0C) << 2))) - 32.f)*s1);
+        d4[16 + 4*p + i] = half4((float4(char4((a >>  4) | ((c & 0x30) << 0))) - 32.f)*s2);
+        d4[24 + 4*p + i] = half4((float4(char4((b >>  4) | ((c & 0xC0) >> 2))) - 32.f)*s3);
+    }
+}
+
+template<typename block_q, short NC>
+kernel void kernel_mul_mv_mma_f32(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    constexpr short NB = 8*NC; // src1 rows per threadgroup
+
+    threadgroup half * sb = (threadgroup half *) shmem;                                   // [NB][KS]
+    threadgroup half * sa = (threadgroup half *) shmem + NB*MV_MMA_KS + sgitg*MV_MMA_RS*MV_MMA_KS; // [RS][KS]
+
+    const int r0 = tgpig.x*(MV_MMA_NSG*MV_MMA_RS) + sgitg*MV_MMA_RS; // first src0 row of this simdgroup
+    const int r1 = tgpig.y*NB;
+    const int im = tgpig.z;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+
+    // dequant role of this lane: src0 row r0 + tiisg/2, half p of the K step
+    const short drow = tiisg/2;
+    const short dp   = tiisg%2;
+    device const block_q * xr = (device const block_q *) (src0 + offset0 + (uint64_t) min(r0 + drow, args.ne01 - 1)*args.nb01);
+    threadgroup half * sa_dst = sa + drow*MV_MMA_KS + 64*dp;
+
+    // src1 staging role: row bn, 16 consecutive k
+    const short bn = tiitg/8;
+    const short bk = 16*(tiitg%8);
+    const bool  b_active = bn < NB;
+    const bool  b_valid  = b_active && (r1 + bn < args.ne11);
+    device const float4 * yr = (device const float4 *) (src1 + (uint64_t) min(r1 + bn, args.ne11 - 1)*args.nb11 + (uint64_t)i12*args.nb12 + (uint64_t)i13*args.nb13) + bk/4;
+
+    simdgroup_float8x8 mc[2][NC];
+    FOR_UNROLL (short i = 0; i < 2; ++i) {
+        FOR_UNROLL (short j = 0; j < NC; ++j) {
+            mc[i][j] = make_filled_simdgroup_matrix<float, 8>(0.f);
+        }
+    }
+
+    for (int k0 = 0; k0 < args.ne00; k0 += MV_MMA_KS) {
+        // load next weights and src1 before the barrier that protects the previous step's reads
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        if (b_active) {
+            threadgroup half4 * sb4 = (threadgroup half4 *) (sb + bn*MV_MMA_KS + bk);
+            FOR_UNROLL (short i = 0; i < 4; ++i) {
+                sb4[i] = b_valid ? half4(yr[k0/4 + i]) : half4(0.h);
+            }
+        }
+
+        mv_mma_deq(xr, k0, dp, sa_dst);
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        FOR_UNROLL (short kb = 0; kb < MV_MMA_KS/8; ++kb) {
+            simdgroup_half8x8 ma[2];
+            simdgroup_half8x8 mb[NC];
+            FOR_UNROLL (short i = 0; i < 2; ++i) {
+                simdgroup_load(ma[i], sa + 8*i*MV_MMA_KS + 8*kb, MV_MMA_KS, 0, false);
+            }
+            FOR_UNROLL (short j = 0; j < NC; ++j) {
+                simdgroup_load(mb[j], sb + 8*j*MV_MMA_KS + 8*kb, MV_MMA_KS, 0, true);
+            }
+            FOR_UNROLL (short i = 0; i < 2; ++i) {
+                FOR_UNROLL (short j = 0; j < NC; ++j) {
+                    simdgroup_multiply_accumulate(mc[i][j], ma[i], mb[j], mc[i][j]);
+                }
+            }
+        }
+    }
+
+    // C[row][n] -> dst[n*ne0 + row]
+    device float * D = (device float *) dst + (uint64_t)im*args.ne0*args.ne1;
+
+    if (r0 + MV_MMA_RS <= args.ne01 && r1 + NB <= args.ne11) {
+        FOR_UNROLL (short i = 0; i < 2; ++i) {
+            FOR_UNROLL (short j = 0; j < NC; ++j) {
+                simdgroup_store(mc[i][j], D + (uint64_t)(r1 + 8*j)*args.ne0 + r0 + 8*i, args.ne0, 0, true);
+            }
+        }
+    } else {
+        // partial tile: go through this simdgroup's own threadgroup slice (RS x KS halves >= RS x NB floats);
+        // only this simdgroup ever reads that slice, so a simdgroup barrier is enough (the branch is not uniform
+        // across the threadgroup)
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        threadgroup float * sc = (threadgroup float *) sa; // [NB][RS]
+        FOR_UNROLL (short i = 0; i < 2; ++i) {
+            FOR_UNROLL (short j = 0; j < NC; ++j) {
+                simdgroup_store(mc[i][j], sc + 8*j*MV_MMA_RS + 8*i, MV_MMA_RS, 0, true);
+            }
+        }
+        simdgroup_barrier(mem_flags::mem_threadgroup);
+        for (short e = tiisg; e < NB*MV_MMA_RS; e += N_SIMDWIDTH) {
+            const short n = e/MV_MMA_RS, row = e%MV_MMA_RS;
+            if (r1 + n < args.ne11 && r0 + row < args.ne01) {
+                D[(uint64_t)(r1 + n)*args.ne0 + r0 + row] = sc[e];
+            }
+        }
+    }
+}
