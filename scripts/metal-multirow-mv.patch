+static inline void helper_mv_mr_write(
+        constant ggml_metal_kargs_mul_mv & args,
+        device char * dst,
+        thread float (&sumf)[R][NR0],
+        int first_row, int r1, int im, ushort tiisg) {
+    FOR_UNROLL (short r = 0; r < R; ++r) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[r][row] = simd_sum(sumf[r][row]);
+        }
+    }
+
+    if (tiisg == 0) {
+        device float * dst_f32 = (device float *) dst + (uint64_t)im*args.ne0*args.ne1 + (uint64_t)r1*args.ne0 + first_row;
+
+        FOR_UNROLL (short r = 0; r < R; ++r) {
+            if (r1 + r >= args.ne11) {
+                break;
+            }
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                if (first_row + row < args.ne01) {
+                    dst_f32[(uint64_t)r*args.ne0 + row] = sumf[r][row];
+                }
+            }
+        }
+    }
+}
