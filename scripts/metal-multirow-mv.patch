+    const int16_t ne12 = (int16_t) op->src[1]->ne[2];
+    const int16_t r2   = (int16_t) (op->src[1]->ne[2] / op->src[0]->ne[2]);
+    const int16_t r3   = (int16_t) (op->src[1]->ne[3] / op->src[0]->ne[3]);
+
+    snprintf(base, 256, "kernel_mul_mv_mma_%s_f32_nc_%d", ggml_type_name(op->src[0]->type), nc);
+    snprintf(name, 256, "%s_ne12=%d_r2=%d_r3=%d", base, ne12, r2, r3);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        ggml_metal_cv_t cv = ggml_metal_cv_init();
+
+        ggml_metal_cv_set_int16(cv, 4,    FC_MUL_MV + 0);
+        ggml_metal_cv_set_int16(cv, ne12, FC_MUL_MV + 2);
+        ggml_metal_cv_set_int16(cv, r2,   FC_MUL_MV + 3);
+        ggml_metal_cv_set_int16(cv, r3,   FC_MUL_MV + 4);
+
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+
+        ggml_metal_cv_free(cv);
+    }
+
+    // 64 src0 rows x 8*nc src1 rows per threadgroup, 4 simdgroups;
+    // threadgroup memory: src1 tile (8*nc x 128 half) + 4 weight tiles (16 x 128 half)
+    res.nr0  = 64;
+    res.nr1  = 8*nc;
+    res.nsg  = 4;
+    res.smem = (size_t) (8*nc + 64)*128*sizeof(uint16_t);
+
+    return res;
+}
